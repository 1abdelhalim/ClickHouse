SELECT
    uniq(x),
    uniqExact(x),
    uniqHLL12(x),
    uniqCombined(x),
    uniqCombined64(x)
FROM
(
    SELECT modulo(number, 2) AS x
    FROM numbers(10)
)
SELECT
    uniq(plus(x, y)),
    uniqExact(plus(x, y)),
    uniqHLL12(plus(x, y)),
    uniqCombined(plus(x, y)),
    uniqCombined64(plus(x, y))
FROM
(
    SELECT
        modulo(number, 2) AS x,
        number % 3 AS y
    FROM numbers(10)
)
SELECT
    uniq(-x),
    uniqExact(-x),
    uniqHLL12(-x),
    uniqCombined(-x),
    uniqCombined64(-x)
FROM
(
    SELECT modulo(number, 2) AS x
    FROM numbers(10)
)
SELECT
    uniq(bitNot(x)),
    uniqExact(bitNot(x)),
    uniqHLL12(bitNot(x)),
    uniqCombined(bitNot(x)),
    uniqCombined64(bitNot(x))
FROM
(
    SELECT modulo(number, 2) AS x
    FROM numbers(10)
)
SELECT
    uniq(bitNot(-x)),
    uniqExact(bitNot(-x)),
    uniqHLL12(bitNot(-x)),
    uniqCombined(bitNot(-x)),
    uniqCombined64(bitNot(-x))
FROM
(
    SELECT modulo(number, 2) AS x
    FROM numbers(10)
)
SELECT
    uniq(-bitNot(-x)),
    uniqExact(-bitNot(-x)),
    uniqHLL12(-bitNot(-x)),
    uniqCombined(-bitNot(-x)),
    uniqCombined64(-bitNot(-x))
FROM
(
    SELECT modulo(number, 2) AS x
    FROM numbers(10)
)
SELECT countDistinct(-bitNot(-x))
FROM
(
    SELECT modulo(number, 2) AS x
    FROM numbers(10)
)
SELECT uniq(concatAssumeInjective(\'x\', \'y\'))
FROM numbers(10)
