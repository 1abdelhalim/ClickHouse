SELECT i
FROM cnf_test
WHERE not(or(greater(i, 1), greater(i, 2)))
SELECT i
FROM cnf_test
WHERE not(and(greater(i, 1), greater(i, 2)))
SELECT i
FROM cnf_test
WHERE or(or(and(greater(i, 1), greater(i, 2)), and(greater(i, 3), greater(i, 4))), and(greater(i, 5), greater(i, 6)))
SELECT i
FROM cnf_test
WHERE not(and(and(or(greater(i, 1), greater(i, 2)), or(greater(i, 3), greater(i, 4))), or(greater(i, 5), greater(i, 6))))
SELECT i
FROM cnf_test
WHERE or(or(and(and(greater(i, 1), greater(i, 2)), greater(i, 7)), and(and(greater(i, 3), greater(i, 4)), greater(i, 8))), and(greater(i, 5), greater(i, 6)))
SELECT i
FROM cnf_test
WHERE and(and(or(or(greater(i, 1), greater(i, 2)), greater(i, 7)), or(or(greater(i, 3), greater(i, 4)), greater(i, 8))), not(or(greater(i, 5), greater(i, 6))))
