SELECT *
FROM executable(\'\', \'JSON\', \'data String\')
--------------------
SELECT *
FROM executable(\'\', \'JSON\', \'data String\', SETTINGS equals(max_command_execution_time, 100))
--------------------
SELECT *
FROM executable(\'\', \'JSON\', \'data String\', SETTINGS equals(max_command_execution_time, 100), equals(command_read_timeout, 1))
--------------------
