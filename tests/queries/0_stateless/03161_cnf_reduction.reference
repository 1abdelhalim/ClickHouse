-- Expected plan with analyzer:
SELECT id
FROM `03161_table`
WHERE and(f, or(not(f), f))
SETTINGS equals(convert_query_to_cnf, 1), equals(optimize_using_constraints, 1), equals(enable_analyzer, 1)

-- Expected result with analyzer:
1

-- Expected plan w/o analyzer:
SELECT id
FROM `03161_table`
WHERE f
SETTINGS equals(convert_query_to_cnf, 1), equals(optimize_using_constraints, 1), equals(enable_analyzer, 0)

-- Expected result w/o analyzer:
1

-- Reproducer from the issue with analyzer
2

-- Reproducer from the issue w/o analyzer
2
